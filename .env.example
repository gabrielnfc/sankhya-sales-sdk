# =============================================================================
# SANDBOX — ambiente de testes. ESCRITA PERMITIDA.
# Prefixo SANKHYA_* = SEMPRE sandbox. Todo teste de integracao le daqui.
# =============================================================================
SANKHYA_BASE_URL=https://api.sandbox.sankhya.com.br
SANKHYA_CLIENT_ID=
SANKHYA_CLIENT_SECRET=
SANKHYA_X_TOKEN=

# =============================================================================
# PRODUCAO — SOMENTE LEITURA. ESCRITA PROIBIDA, SEM EXCECAO.
# Prefixo SANKHYA_PROD_* = producao. Nunca usar em teste de escrita.
# Opt-in explicito: so suites read-only leem estas chaves.
#
# NAO reutilize os nomes do bloco de sandbox aqui. Chave duplicada no .env
# faz o segundo bloco sombrear o primeiro em silencio — e ja apontou o suite
# de escrita para producao. `vitest.config.ts` agora falha em duplicata.
# =============================================================================
SANKHYA_PROD_BASE_URL=https://api.sankhya.com.br
SANKHYA_PROD_CLIENT_ID=
SANKHYA_PROD_CLIENT_SECRET=
SANKHYA_PROD_X_TOKEN=
